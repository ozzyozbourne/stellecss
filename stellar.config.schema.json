        },
        "fontImports": {
          "type": "boolean"
        },
        "lineLimit": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        },
        "minifyIdentifiers": {
          "type": "boolean"
        },
        "minifySyntax": {
          "type": "boolean"
        },
        "minifyWhitespace": {
          "type": "boolean"
        },
        "namespace": {
          "description": "Selector that receives the custom properties.",
          "type": "string"
        },
        "output": {
          "description": "Bundle path relative to the config file.",
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        },
        "reducedMotion": {
          "description": "Zero durations under prefers-reduced-motion: reduce.",
          "type": "boolean"
        },
        "sourceRoot": {
          "type": "string"
        },
        "sourcemap": {
          "enum": [
            "none",
            "inline",
            "external"
          ],
          "type": "string"
        },
        "sourcesContent": {
          "type": "boolean"
        }
