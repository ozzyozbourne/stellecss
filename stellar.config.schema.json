                "linear",
                "in-quad",
                "out-quad",
                "in-out-quad",
                "in-out-cubic",
                "in-out-sine"
              ],
              "type": "string"
            },
            "harmonyMode": {
              "description": "How secondary and tertiary hues relate to primary.",
