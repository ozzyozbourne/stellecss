          "additionalProperties": false,
          "properties": {
            "dimTargetLc": {
              "description": "APCA Lc the -dim colour aims for against its tone.",
              "maximum": 108,
              "minimum": 0,
              "type": "number"
            },
            "disabled": {
              "type": "boolean"
            },
